#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-while-undecided;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        COM_SEM: COM_SEM {
            compatible = "zmk,behavior-mod-morph";
            label = "COM_SEM";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        DOT_COL: DOT_COL {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COL";
            bindings = <&kp DOT>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp END     &kp Q  &kp W         &kp E            &kp R              &kp T                &kp Y             &kp U               &kp I             &kp O         &kp P             &kp EQUAL
&caps_word  &kp A  &HML LCTRL S  &HML LEFT_GUI D  &HML LEFT_SHIFT F  &HML LEFT_ALT G      &HMR RIGHT_ALT H  &HMR RIGHT_SHIFT J  &HMR RIGHT_GUI K  &HMR LCTRL L  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp HOME    &kp Z  &kp X         &kp C            &kp V              &kp B                &kp N             &kp M               &COM_SEM          &DOT_COL      &kp FSLH          &kp MINUS
                                 &lt 7 ESCAPE     &lt 6 TAB          &lt 5 SPACE          &lt 2 RET         &lt 3 BSPC          &lt 4 DEL
            >;
        };

        standard_layer {
            display-name = "STD";
            bindings = <
&kp ESC    &kp Q  &kp W      &kp E     &kp R      &kp T      &kp Y    &kp U       &kp I         &kp O    &kp P             &kp EQUAL
&kp TAB    &kp A  &kp S      &kp D     &kp F      &kp G      &kp H    &kp J       &kp K         &kp L    &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LSHFT  &kp Z  &kp X      &kp C     &kp V      &kp B      &kp N    &kp M       &kp COMMA     &kp DOT  &kp FSLH          &kp MINUS
                  &kp LCTRL  &kp LALT  &kp SPACE             &kp RET  &lt 3 BSPC  &kp LEFT_GUI
            >;
        };

        symbol_layer {
            bindings = <
&trans  &kp LESS_THAN  &kp GREATER_THAN  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES     &kp TILDE                  &none   &none   &none   &none   &none  &none
&trans  &kp AT         &kp CARET         &kp POUND         &kp ASTRK             &kp DOLLAR                 &trans  &trans  &trans  &trans  &none  &none
&trans  &kp PERCENT    &kp GRAVE         &kp AMPS          &kp PIPE              &kp BACKSLASH              &none   &none   &none   &none   &none  &none
                                         &kp EXCLAMATION   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS      &trans  &none   &none
            >;

            label = "SYM";
        };

        number_layer {
            display-name = "NUM";
            bindings = <
&tog 1  &none  &kp N9  &kp N8   &kp N7  &none          &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&none   &none  &kp N6  &kp N5   &kp N4  &none          &trans  &trans  &trans  &trans   &none    &none
&none   &none  &kp N3  &kp N2   &kp N1  &none          &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
                       &kp DOT  &kp N0  &kp COMMA      &none   &trans  &none
            >;
        };

        keyboard_layer {
            display-name = "KB";
            bindings = <
&sys_reset   &none  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD      &none   &none   &none   &none   &none  &sys_reset
&bootloader  &none  &none            &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG      &trans  &trans  &trans  &trans  &none  &bootloader
&bt BT_CLR   &none  &none            &bt BT_NXT       &bt BT_PRV       &studio_unlock       &none   &none   &none   &none   &none  &none
                                     &none            &none            &none                &none   &none   &trans
            >;
        };

        navigation_layer {
            bindings = <
&none  &none  &kp LG(X)  &kp LG(V)      &kp LG(C)  &none       &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &none  &none
&none  &none  &trans     &trans         &trans     &trans      &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none  &none
&none  &none  &none      &kp LS(LG(Z))  &kp LG(Z)  &none       &none     &none          &none        &none      &none  &none
                         &none          &none      &trans      &kp RET   &kp BACKSPACE  &kp DEL
            >;

            label = "NAV";
        };

        app_layer {
            display-name = "APP";
            bindings = <
&none  &kp LS(LA(LC(LG(Q))))  &kp LS(LA(LC(LG(W))))  &kp LS(LA(LC(LG(E))))  &kp LS(LA(LC(LG(R))))  &kp LS(LA(LC(LG(T))))      &kp LS(LA(LC(LG(Y))))    &kp LS(LA(LC(LG(U))))      &kp LS(LA(LC(LG(I))))    &kp LS(LA(LC(LG(O))))  &kp LS(LA(LC(LG(P))))  &none
&none  &kp LS(LA(LC(LG(A))))  &kp LS(LA(LC(LG(S))))  &kp LS(LA(LC(LG(D))))  &kp LS(LA(LC(LG(F))))  &kp LS(LA(LC(LG(G))))      &kp LS(LA(LC(LG(H))))    &kp LS(LA(LC(LG(J))))      &kp LS(LA(LC(LG(K))))    &kp LS(LA(LC(LG(L))))  &none                  &none
&none  &kp LS(LA(LC(LG(Z))))  &kp LS(LA(LC(LG(X))))  &kp LS(LA(LC(LG(C))))  &kp LS(LA(LC(LG(V))))  &kp LS(LA(LC(LG(B))))      &kp LS(LA(LC(LG(N))))    &kp LS(LA(LC(LG(M))))      &none                    &none                  &none                  &none
                                                     &none                  &trans                 &none                      &kp LS(LA(LC(LG(RET))))  &kp LS(LA(LG(LC(SPACE))))  &kp LS(LA(LC(LG(TAB))))
            >;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
&none        &none  &none   &none   &none   &none       &kp C_PLAY_PAUSE  &kp C_PREV     &kp C_NEXT            &none  &none  &none
&none        &none  &trans  &trans  &trans  &trans      &kp K_MUTE        &kp C_VOL_DN   &kp C_VOLUME_UP       &none  &none  &none
&bootloader  &none  &none   &none   &none   &none       &none             &kp C_BRI_DEC  &kp C_BRIGHTNESS_INC  &none  &none  &none
                            &trans  &none   &none       &none             &none          &none
            >;
        };
    };
};
